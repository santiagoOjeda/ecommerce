rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product public images
    match /tenants/{tenantId}/products/{allPaths=**} {
      allow read: if true;
      // Allow image uploads if authenticated or in dev mode
      allow write: if request.auth != null;
    }

    // Tenant logos
    match /tenants/{tenantId}/brand/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
